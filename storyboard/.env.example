# Copy to .env and fill in what you have. Everything is optional.
# The app runs with none of these set: Pollinations image generation and the
# offline shot-list engine need no keys.

# FrameThrower reference stills (free $2 credit on signup, no card):
# https://framethrower.ai/register  ->  Settings -> API -> Create token
FRAMETHROWER_TOKEN=

# Free daily image allowance via Cloudflare Workers AI (free account):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Paid / quota-limited image providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Claude writes the shot breakdown instead of the offline rule engine
ANTHROPIC_API_KEY=

PORT=8787
