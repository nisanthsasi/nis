reduced_coverage_variant, devices_used[{device, setup_ref, pays}]}, option_B{same shape, label "B"}, pleasure_beat,
energy_check{asl_target_s, camera_velocity, cut_rate, sequence_energy_target, plan_energy, matches, note},
resonance_A and resonance_B{dramatic_fidelity, emotional_impact, engagement, style_coherence, feasibility, earned_freshness,
justifications[{criterion, note}], consensus_device_penalty} (leave weighted_total null — the orchestrator fills it),
department_handoff{colour_stance, music_stance, sound_stance, design_stance, performance_stance},
the_shot_it_cannot_live_without{shot_no, why}. Then: contributions[{element, lens}], unresolved_tensions[],
pleasure_none_reason, trailer_shot, must_remember_delivery, devices_used[{device, setup_ref, pays}],
human_questions[{id "HQ-{{ scene.id }}-n", scene_id, raised_by "integrator", question, options[2], conservative_option 0|1, rationale}],
