{% else %}
  - none — no earned device is permitted in this film
{% endfor %}
- signature devices of the film: {{ style_bible.signature_devices | join("; ") if style_bible.signature_devices else "none declared" }}
- refusals of the film: {{ style_bible.refusals | join("; ") if style_bible.refusals else "none declared" }}
- grammar: camera {{ style_bible.style.camera_grammar }} · lenses {{ style_bible.style.lens_policy }} · movement {{ style_bible.style.movement_policy }} · light {{ style_bible.style.light_policy }} · editing {{ style_bible.style.editing_grammar }} · sound {{ style_bible.style.sound_philosophy }} · music {{ style_bible.style.music_philosophy }}{% if style_bible.style.bgm_policy %} · BGM {{ style_bible.style.bgm_policy }}{% endif %}{% if style_bible.style.colour_energy %} · colour energy {{ style_bible.style.colour_energy }}{% endif %}

